{
  "schemaVersion": 1,
  "id": "screen-record-linux",
  "name": "Screen Record Linux",
  "version": "1.0.0",
  "summary": "Record an X11 display with ximagesrc, encode H.264, and write an MP4. Linux (X11) only.",
  "author": {
    "name": "gak4u",
    "url": "https://github.com/gak4u"
  },
  "tags": [
    "screen",
    "record",
    "mp4",
    "linux",
    "x11"
  ],
  "license": "PolyForm-NC-1.0",
  "requires": {
    "gstreamer": ">=1.18",
    "elements": [
      "ximagesrc",
      "videoconvert",
      "x264enc",
      "mp4mux",
      "filesink"
    ]
  },
  "pipelines": [
    {
      "file": "pipelines/record.json",
      "name": "Screen Record"
    }
  ],
  "variables": [
    {
      "varName": "location",
      "label": "Output file",
      "default": "/tmp/screen-record.mp4"
    },
    {
      "varName": "kbps",
      "label": "Video Bitrate (kbps)",
      "default": 6000
    },
    {
      "varName": "displayName",
      "label": "X11 display name",
      "default": ":0"
    }
  ]
}
